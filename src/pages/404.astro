---
import { IoChevronForward } from "react-icons/io5";
import Content from "../components/Content.astro";
import Header from "../components/Header.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Page not found"
  description="The requested page could not be found."
  bodyClass="min-h-screen"
>
  <Header />

  <main class="pt-[50px]">
    <Content className="flex flex-col gap-4 items-center mt-10">
      <h1 class="text-3xl mt-14 mb-6">Oops! Page not found...</h1>

      <a
        href="/"
        class="inline-flex items-center gap-1 underline underline-offset-2 opacity-70 hover:opacity-90 transition"
      >
        Go back to index page <IoChevronForward />
      </a>
    </Content>
  </main>
</MainLayout>
