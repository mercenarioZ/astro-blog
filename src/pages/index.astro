---
import { IoArrowForward } from "react-icons/io5";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { INSTAGRAM_URL, SITE_DESCRIPTION } from "../config";
import { Image } from "astro:assets";
import Header from "../components/Header.astro";

interface PostModule {
  url: string;
  frontmatter: {
    createdAt: string;
    heroImage: string;
    tag?: string[];
    tags?: string[];
    title: string;
    description: string;
  };
}

// get all sorted posts
const postModules = import.meta.glob<PostModule>("../pages/posts/*.md", {
  eager: true,
});
const posts = Object.values(postModules) as PostModule[];

posts.sort(
  (a, b) =>
    new Date(b.frontmatter.createdAt).valueOf() -
    new Date(a.frontmatter.createdAt).valueOf()
);

const [featuredPost, ...secondaryPosts] = posts;
const remainingPosts = secondaryPosts.slice(2);

const postDateFormatter = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});

const getPostTag = (post: PostModule) => {
  const tag = post.frontmatter.tags?.[0] ?? post.frontmatter.tag?.[0] ?? "Post";
  return tag.charAt(0).toUpperCase() + tag.slice(1);
};

const getPostDate = (post: PostModule) =>
  postDateFormatter.format(new Date(post.frontmatter.createdAt));
---

<MainLayout description={SITE_DESCRIPTION} title="MercenarioZ's blog">
  <Header />
  <main class="pt-[70px]">
    <Content className="max-w-[1320px] mt-16">
      <section id="fade-target">
        <div
          class="grid grid-cols-1 gap-10 lg:grid-cols-[repeat(16,minmax(0,1fr))] lg:gap-10 xl:gap-12"
        >
          {
            secondaryPosts[0] && (
              <aside
                class="magazine-card magazine-card-left order-2 border-t border-slate-300 pt-10 dark:border-zinc-700 lg:order-1 lg:col-span-4 lg:border-t-0 lg:border-r lg:pr-10 xl:pr-12"
              >
                <a href={secondaryPosts[0].url} class="group block">
                  <figure
                    class="magazine-image mb-5 aspect-[1.55/1] w-full overflow-hidden border border-slate-400 dark:border-zinc-700"
                  >
                    <Image
                      width={520}
                      height={520 / 1.55}
                      src={secondaryPosts[0].frontmatter.heroImage}
                      alt={secondaryPosts[0].frontmatter.title}
                      class="magazine-cover h-full w-full object-cover"
                    />
                  </figure>
                  <div class="mb-3 text-xs font-semibold uppercase text-orange-500">
                    {getPostTag(secondaryPosts[0])}
                  </div>
                  <h2 class="text-xl font-bold leading-tight">
                    {secondaryPosts[0].frontmatter.title}
                  </h2>
                  <p class="mt-3 opacity-80">
                    {secondaryPosts[0].frontmatter.description}
                  </p>
                  <p class="mt-4 text-sm font-medium opacity-60">
                    {getPostDate(secondaryPosts[0])}
                  </p>
                </a>
              </aside>
            )
          }

          {
            featuredPost && (
              <a
                href={featuredPost.url}
                class="magazine-card magazine-card-featured group order-1 block text-center lg:order-2 lg:col-span-8 lg:px-1"
              >
                <figure
                  class="magazine-image aspect-[1.618/1] w-full overflow-hidden border border-slate-400 dark:border-zinc-700"
                >
                  <Image
                    width={1040}
                    height={1040 / 1.618}
                    src={featuredPost.frontmatter.heroImage}
                    alt={featuredPost.frontmatter.title}
                    class="magazine-cover h-full w-full object-cover"
                  />
                </figure>
                <div class="mt-7 text-xs font-semibold uppercase text-orange-500">
                  {getPostTag(featuredPost)}
                </div>
                <h2 class="mt-3 text-3xl font-bold leading-tight lg:text-4xl">
                  {featuredPost.frontmatter.title}
                </h2>

                <p class="mx-auto mt-4 max-w-2xl text-lg opacity-80">
                  {featuredPost.frontmatter.description}
                </p>
                <p class="mt-5 text-sm font-medium opacity-60">
                  {getPostDate(featuredPost)}
                </p>
              </a>
            )
          }

          {
            secondaryPosts[1] && (
              <aside
                class="magazine-card magazine-card-right order-3 border-t border-slate-300 pt-10 dark:border-zinc-700 lg:col-span-4 lg:border-t-0 lg:border-l lg:pl-10 xl:pl-12"
              >
                <a href={secondaryPosts[1].url} class="group block">
                  <figure
                    class="magazine-image mb-5 aspect-[1.55/1] w-full overflow-hidden border border-slate-400 dark:border-zinc-700"
                  >
                    <Image
                      width={520}
                      height={520 / 1.55}
                      src={secondaryPosts[1].frontmatter.heroImage}
                      alt={secondaryPosts[1].frontmatter.title}
                      class="magazine-cover h-full w-full object-cover"
                    />
                  </figure>
                  <div class="mb-3 text-xs font-semibold uppercase text-orange-500">
                    {getPostTag(secondaryPosts[1])}
                  </div>
                  <h2 class="text-xl font-bold leading-tight">
                    {secondaryPosts[1].frontmatter.title}
                  </h2>
                  <p class="mt-3 opacity-80">
                    {secondaryPosts[1].frontmatter.description}
                  </p>
                  <p class="mt-4 text-sm font-medium opacity-60">
                    {getPostDate(secondaryPosts[1])}
                  </p>
                </a>
              </aside>
            )
          }
        </div>

        {
          remainingPosts.length > 0 && (
            <section class="mt-16 border-t border-slate-300 pt-10 dark:border-zinc-700">
              <div class="mb-8 flex items-center justify-between gap-6">
                <h2 class="text-2xl font-bold leading-tight">Latest</h2>
                <span class="text-sm font-medium opacity-60">
                  {remainingPosts.length} more
                </span>
              </div>

              <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {remainingPosts.map((post, index) => (
                  <li
                    class="magazine-card"
                    style={`animation-delay: ${300 + index * 80}ms`}
                  >
                    <a href={post.url} class="group block">
                      <figure class="magazine-image mb-4 aspect-[1.55/1] w-full overflow-hidden border border-slate-400 dark:border-zinc-700">
                        <Image
                          width={420}
                          height={420 / 1.55}
                          src={post.frontmatter.heroImage}
                          alt={post.frontmatter.title}
                          class="magazine-cover h-full w-full object-cover"
                        />
                      </figure>
                      <div class="mb-2 text-xs font-semibold uppercase text-orange-500">
                        {getPostTag(post)}
                      </div>
                      <h2 class="text-lg font-bold leading-tight">
                        {post.frontmatter.title}
                      </h2>
                      <p class="mt-2 text-sm opacity-80">
                        {post.frontmatter.description}
                      </p>
                      <p class="mt-3 text-xs font-medium opacity-60">
                        {getPostDate(post)}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </section>
    </Content>
  </main>

  <Footer />
</MainLayout>

<style>
  .magazine-card {
    animation: magazine-card-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: opacity, transform;
  }

  .magazine-card-left {
    animation-delay: 120ms;
  }

  .magazine-card-featured {
    animation-delay: 40ms;
  }

  .magazine-card-right {
    animation-delay: 220ms;
  }

  .magazine-image {
    transition:
      transform 350ms ease,
      box-shadow 350ms ease;
  }

  .magazine-cover {
    transition:
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 350ms ease,
      opacity 350ms ease;
  }

  .magazine-card:hover .magazine-image {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgb(0 0 0 / 12%);
  }

  .magazine-card:hover .magazine-cover {
    filter: saturate(1.08) contrast(1.03);
    opacity: 0.9;
    transform: scale(1.045);
  }

  @keyframes magazine-card-enter {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .magazine-card,
    .magazine-image,
    .magazine-cover {
      animation: none;
      transition: none;
    }

    .magazine-card:hover .magazine-image,
    .magazine-card:hover .magazine-cover {
      filter: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
