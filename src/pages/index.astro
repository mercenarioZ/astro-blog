---
import "../../styles/home.css";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostCard from "../components/PostCard.astro";
import { SITE_DESCRIPTION } from "../config";
import MainLayout from "../layouts/MainLayout.astro";
import { getPosts } from "../lib/posts";

const posts = getPosts();
---

<MainLayout description={SITE_DESCRIPTION} title="MercenarioZ's blog">
  <Header />

  <main class="home">
    <Content>
      <header class="home-intro">
        <p class="home-intro__edition">Independent notes · Ho Chi Minh City</p>
        <h1>Software, tools, and the life around them.</h1>
        <p class="home-intro__lede">
          A working archive by MercenarioZ—written while building, breaking,
          and learning in public.
        </p>
      </header>

      <section class="post-index" aria-labelledby="archive-title">
        <div class="post-index__heading">
          <h2 id="archive-title">The archive</h2>
          <p>{posts.length} entries, newest first</p>
        </div>

        <ol class="post-index__list">
          {
            posts.map((post, index) => (
              <li>
                <PostCard post={post} index={index + 1} />
              </li>
            ))
          }
        </ol>
      </section>
    </Content>
  </main>

  <Footer />
</MainLayout>
