---
import "../../styles/about.css";
import { Image } from "astro:assets";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SideProjects from "../components/SideProjects.vue";
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import {
  aboutCapabilityRows,
  aboutEducation,
  aboutFragments,
  aboutHero,
  aboutLinks,
  aboutPrinciples,
  aboutWorkExperience,
} from "../constants/about";

const sideProjectEntries = await getCollection("sideProjects");
const aboutSideProjects = sideProjectEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    title: project.data.title,
    status: project.data.status,
    links: project.data.links ?? [],
    stack: project.data.stack,
    bodyHtml: project.rendered?.html ?? project.body ?? "",
  }));
---

<MainLayout title="About">
  <Header />

  <main class="about">
    <Content className="about-shell">
      <header class="about-hero">
        <p class="about-label">{aboutHero.kicker}</p>
        <h1>{aboutHero.title}</h1>
        <div class="about-hero__details">
          <p>{aboutHero.description}</p>
          <aside>
            <span>Current mode</span>
            <strong>{aboutHero.mode}</strong>
          </aside>
        </div>
        <nav class="about-links" aria-label="Social links">
          <a href={aboutLinks.github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
          <a
            href={aboutLinks.instagram}
            target="_blank"
            rel="noopener noreferrer">Instagram ↗</a
          >
        </nav>
      </header>

      <section class="about-section about-principles">
        <h2>Working principles</h2>
        <div class="about-principles__list">
          {
            aboutPrinciples.map((principle, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section about-vocabulary">
        <h2>Working vocabulary</h2>
        <div class="about-vocabulary__rows">
          {
            aboutCapabilityRows.map((row) => (
              <div>
                <h3>{row.label}</h3>
                <p>{row.items.map((item) => item.label).join(" · ")}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="about-section about-notes">
        <h2>Notes from the desk</h2>
        <ul>
          {aboutFragments.map((fragment) => <li>{fragment}</li>)}
        </ul>
      </section>

      <section class="about-section about-history">
        <h2>History</h2>
        <div class="about-history__columns">
          <div>
            <h3 class="about-subheading">Work</h3>
            {
              aboutWorkExperience.map((entry) => (
                <article class="about-entry">
                  <time>{entry.period}</time>
                  <h4>{entry.title}</h4>
                  <p class="about-entry__place">{entry.place}</p>
                  <p>{entry.body}</p>
                </article>
              ))
            }
          </div>

          <div>
            <h3 class="about-subheading">Education</h3>
            {
              aboutEducation.map((entry) => (
                <article class="about-entry about-entry--education">
                  {"image" in entry && (
                    <Image
                      src={entry.image}
                      alt={entry.imageAlt}
                      width={56}
                      loading="lazy"
                    />
                  )}
                  <div>
                    <time>{entry.period}</time>
                    <h4>{entry.title}</h4>
                    <p class="about-entry__place">{entry.place}</p>
                    <p>{entry.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <SideProjects projects={aboutSideProjects} />
    </Content>
  </main>

  <Footer />
</MainLayout>
