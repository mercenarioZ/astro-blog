---
import HeaderLink from "./HeaderLink.astro";
import { IoClose, IoLogoGithub, IoMenu } from "react-icons/io5";
import ThemeToggleButton from "./ThemeToggleButton.vue";
---

<header
  transition:name="site-header"
  transition:animate="none"
  transition:persist
  class="site-header"
>
  <div class="site-header__inner">
    <a href="/" class="site-wordmark" aria-label="MercenarioZ home">
      MercenarioZ
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <div class="site-nav__links">
        <HeaderLink href="/about">About</HeaderLink>
        <HeaderLink target="_blank" href="https://github.com/mercenarioZ">
          <IoLogoGithub aria-hidden="true" /> GitHub
        </HeaderLink>
      </div>

      <div class="site-nav__menu" data-mobile-nav>
        <button
          type="button"
          class="site-nav__menu-button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          data-mobile-nav-button
        >
          <span data-mobile-nav-open><IoMenu aria-hidden="true" /></span>
          <span hidden data-mobile-nav-close><IoClose aria-hidden="true" /></span>
        </button>

        <div
          id="mobile-nav-menu"
          class="site-nav__sheet"
          hidden
          data-mobile-nav-menu
        >
          <div class="site-nav__sheet-inner">
            <HeaderLink href="/about">About</HeaderLink>
            <HeaderLink
              target="_blank"
              href="https://github.com/mercenarioZ"
            >
              <IoLogoGithub aria-hidden="true" /> GitHub
            </HeaderLink>
          </div>
        </div>
      </div>

      <ThemeToggleButton client:load />
    </nav>
  </div>
</header>

<script>
  const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";

  const updateActiveNavLinks = () => {
    const currentPath = normalizePath(window.location.pathname);

    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
      .forEach((link) => {
        const linkPath = normalizePath(new URL(link.href).pathname);
        const isActive = linkPath === currentPath;

        link.classList.toggle("active", isActive);
        if (isActive) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
  };

  const setupMobileNav = () => {
    const nav = document.querySelector("[data-mobile-nav]");
    const button = nav?.querySelector("[data-mobile-nav-button]");
    const menu = nav?.querySelector<HTMLElement>("[data-mobile-nav-menu]");
    const openIcon = nav?.querySelector<HTMLElement>("[data-mobile-nav-open]");
    const closeIcon = nav?.querySelector<HTMLElement>("[data-mobile-nav-close]");

    if (!nav || !button || !menu || !openIcon || !closeIcon) return;

    const setOpen = (isOpen: boolean) => {
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu",
      );
      menu.hidden = !isOpen;
      openIcon.hidden = isOpen;
      closeIcon.hidden = !isOpen;
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!nav.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    document.addEventListener("astro:before-swap", () => setOpen(false));
  };

  setupMobileNav();
  updateActiveNavLinks();
  document.addEventListener("astro:page-load", updateActiveNavLinks);
</script>
