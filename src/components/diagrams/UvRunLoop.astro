        <!-- Nodes -->
        <g id="node-boot" data-step="boot" tabindex="0" role="button" aria-pressed="false" aria-label="Node boots — V8 and the libuv loop" data-detail="node main.js starts one process. On the main thread, Node sets up a V8 isolate and a libuv loop, then loads your script.">
          <rect x="252.6" y="-98" width="140" height="44" class="c-mask" />
          <rect x="252.6" y="-98" width="140" height="44" class="c-external" stroke-width="1.5" />
          <text x="322.6" y="-79" class="t-primary" font-size="10" font-weight="600" text-anchor="middle">Node boots</text>
          <text x="322.6" y="-65" class="t-muted" font-size="8" text-anchor="middle">V8 + libuv loop set up</text>
        </g>

        <g id="node-main" data-step="main" tabindex="0" role="button" aria-pressed="false" aria-label="Main script — V8 runs it to the end" data-detail="Your top-level code runs synchronously in V8. Each async call only registers work: timers go to Node's lists, fs work goes to libuv, promise reactions go to V8's queue.">
          <rect x="432.6" y="-98" width="140" height="44" class="c-mask" />
          <rect x="432.6" y="-98" width="140" height="44" class="c-external" stroke-width="1.5" />
