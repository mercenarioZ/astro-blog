    </div>
    <figcaption>
      libuv's loop on the left, what it calls into on the right, all on one thread; only <code>uv__io_poll()</code> waits. Click a step for details, or trace a path below.
    </figcaption>
  </figure>
  <div class="uv-loop__traces" role="group" aria-label="Trace a path">
    <span>Trace:</span>
    <button
      type="button"
      aria-pressed="false"
      data-uv-trace="callback"
      data-steps="poll loop glue v8 js ticks promises"
      data-title="One I/O callback, end to end"
      data-detail="3 · Poll finds a finished read. libuv calls Node's C++ glue, Node enters V8, and V8 runs your callback to completion. When it returns, Node drains nextTick, then V8's promise queue, and only then does the loop move on."
    >a callback, end to end</button>
    <button
      type="button"
      aria-pressed="false"
      data-uv-trace="io"
      data-steps="poll check close timers"
      data-title="Inside an I/O callback: setImmediate wins, every time"
      data-detail="The callback is running in 3 · Poll. The very next stop is 4 · Check, where the immediate runs; 6 · Timers comes two steps later. Nothing about it is random."
    >immediate vs timeout, in I/O</button>
    <button
      type="button"
      aria-pressed="false"
      data-uv-trace="main"
      data-steps="main drain start pending idle poll check"
      data-title="From the main script: it depends on the clock"
      data-detail="setTimeout(0) is really 1 ms. If a millisecond has passed when uv_run() starts, the one-off timer pass fires it first. If not, the loop moves on; the idle handle Node started for the immediate stops 3 · Poll from sleeping, and 4 · Check runs it first."
    >immediate vs timeout, main script</button>
  </div>
  <div class="uv-loop__panel" aria-live="polite" data-uv-panel>
    <p class="uv-loop__panel-title" data-uv-title></p>
    <p class="uv-loop__panel-text" data-uv-desc></p>
  </div>
</div>

<style>
  /* The drawing is compact, so a 68rem frame keeps its labels at reading
     size; below that the frame scrolls instead of shrinking them into the floor. */
  .uv-loop {
    --uv-loop-frame: min(100vw - 2rem, 68rem);

    width: var(--uv-loop-frame);
    margin-inline: calc((100% - var(--uv-loop-frame)) / 2);
    margin-block: var(--space-lg);
    padding-block: var(--space-sm) var(--space-xs);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .uv-loop__figure {
    margin: 0;
  }

  .uv-loop__scroll {
    overflow-x: auto;
  }

  .uv-loop__svg {
    display: block;
    width: 100%;
    min-width: 46rem;
    height: auto;
    font-family: var(--font-outlier);
  }

  /* Palette: paper, ink, rule, and the single burnt-orange accent. */
  .c-lane {
    fill: none;
    stroke: var(--color-rule);
  }

  .c-strip {
    fill: none;
    stroke: var(--color-rule);
    stroke-dasharray: 4 3;
  }

  .c-backend {
    fill: var(--color-paper-2);
    stroke: var(--color-rule-2);
  }

  .c-external {
    fill: var(--color-paper);
    stroke: var(--color-rule-2);
    stroke-dasharray: 4 3;
  }

  .c-mask {
    fill: var(--color-paper);
  }

  .a-default {
    fill: none;
    stroke: var(--color-rule-2);
  }

  .m-default {
    fill: var(--color-rule-2);
  }

  .t-primary {
    fill: var(--color-ink);
  }

  .t-muted {
    fill: var(--color-muted);
  }

  .t-backend {
    fill: var(--color-accent);
  }

  .s-backend {
    color: var(--color-rule-2);
  }

  .s-external {
    color: var(--color-muted);
  }

  .semantic-sigil {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .semantic-sigil .sigil-fill {
    fill: currentColor;
    stroke: none;
  }

  /* Exploration: the chosen step or trace and its relationships stay lit. */
  [data-step] {
    cursor: pointer;
  }

  [data-step]:focus {
    outline: none;
  }

  [data-step]:focus-visible > rect:not(.c-mask) {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  .uv-loop[data-focus] [data-step],
  .uv-loop[data-focus] [data-edge-from] {
    opacity: 0.5;
    transition: opacity var(--dur-micro) var(--ease-out);
  }

  .uv-loop[data-focus] .is-on {
    opacity: 1;
  }

  :global(:root.dark) .uv-loop[data-focus] [data-step]:not(.is-on),
  :global(:root.dark) .uv-loop[data-focus] [data-edge-from]:not(.is-on) {
    opacity: 0.35;
  }

  .uv-loop[data-focus] [data-edge-from].is-on {
    stroke-width: 2;
  }

  [data-step].is-on > rect:not(.c-mask) {
    stroke: var(--color-accent);
    stroke-width: 1.6;
  }

  .uv-loop__traces {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
    color: var(--color-muted);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
  }

  .uv-loop__traces button {
    padding: 0.15rem 0.5rem;
    border: var(--rule-hair) solid var(--color-rule-2);
    background: none;
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }

  .uv-loop__traces button[aria-pressed="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .uv-loop__panel {
    display: grid;
    gap: 0.35rem;
  }

  .uv-loop__panel[data-active] {
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .uv-loop__panel-title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .uv-loop__panel-text {
    margin: 0;
    max-width: 62ch;
    color: var(--color-ink-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  figcaption {
    max-width: 68ch;
    margin-block-start: var(--space-sm);
    color: var(--color-muted);
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .uv-loop[data-focus] [data-step],
    .uv-loop[data-focus] [data-edge-from] {
      transition: none;
    }
  }
</style>

<script>
  type Focus = {
    key: string;
    lit: Set<string>;
    // A trace lights only the edges inside the path; a single step lights all of its edges.
    trace: boolean;
    title: string;
    detail: string;
  };

  // Works on first load and after Astro's client-side navigation, and binds
  // each figure only once.
  const setup = () => {
    for (const figure of document.querySelectorAll<HTMLElement>("[data-uv-loop]")) {
      if (figure.hasAttribute("data-uv-ready")) continue;
      figure.setAttribute("data-uv-ready", "true");

      const svg = figure.querySelector("svg");
      const panel = figure.querySelector("[data-uv-panel]");
      const title = figure.querySelector("[data-uv-title]");
      const description = figure.querySelector("[data-uv-desc]");
      if (!svg || !panel || !title || !description) continue;

      const steps = [...svg.querySelectorAll<SVGElement>("[data-step]")];
      const edges = [...svg.querySelectorAll<SVGElement>("[data-edge-from]")];
      const traces = [...figure.querySelectorAll<HTMLButtonElement>("[data-uv-trace]")];

      let focus: Focus | null = null;

      const isEdgeOn = (edge: SVGElement) => {
        if (!focus) return false;
        const from = focus.lit.has(edge.dataset.edgeFrom ?? "");
        const to = focus.lit.has(edge.dataset.edgeTo ?? "");
        return focus.trace ? from && to : from || to;
      };

      const render = () => {
        figure.toggleAttribute("data-focus", focus !== null);
        for (const step of steps) {
          const id = step.dataset.step ?? "";
          step.classList.toggle("is-on", focus?.lit.has(id) ?? false);
          step.setAttribute("aria-pressed", String(focus?.key === id));
        }
        for (const edge of edges) {
          edge.classList.toggle("is-on", isEdgeOn(edge));
        }
        for (const button of traces) {
          button.setAttribute("aria-pressed", String(focus?.key === `trace:${button.dataset.uvTrace}`));
        }
        title.textContent = focus?.title ?? "";
        description.textContent = focus?.detail ?? "";
        panel.toggleAttribute("data-active", focus !== null);
      };

      // Choosing the same thing twice clears it.
      const toggle = (next: Focus) => {
        focus = focus?.key === next.key ? null : next;
        render();
      };

      for (const step of steps) {
        const id = step.dataset.step;
        if (!id) continue;

        const select = () =>
          toggle({
            key: id,
            lit: new Set([id]),
            trace: false,
            title: step.getAttribute("aria-label") ?? "",
            detail: step.dataset.detail ?? "",
          });

        step.addEventListener("click", select);
        step.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          select();
        });
      }

      for (const button of traces) {
        button.addEventListener("click", () =>
          toggle({
            key: `trace:${button.dataset.uvTrace}`,
            lit: new Set(button.dataset.steps?.split(" ")),
            trace: true,
            title: button.dataset.title ?? "",
            detail: button.dataset.detail ?? "",
          }),
        );
      }
    }
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
