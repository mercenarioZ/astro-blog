          <text x="500.6" y="384.3" class="t-backend" font-size="8" text-anchor="middle">socket close</text>
        </g>

        <g id="node-exit" data-step="exit" tabindex="0" role="button" aria-pressed="false" aria-label="uv_run() returns — no work left" data-detail="Nothing left to wake the loop, so uv_run() returns and Node can exit.">
