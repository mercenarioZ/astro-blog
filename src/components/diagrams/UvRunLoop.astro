          <rect x="836" y="234" width="144" height="50" class="c-mask" />
          <rect x="836" y="234" width="144" height="50" class="c-external" stroke-width="1.5" />
          <text x="908" y="256" class="t-primary" font-size="10" font-weight="600" text-anchor="middle">Your JS callback</text>
          <text x="908" y="270" class="t-muted" font-size="8" text-anchor="middle">runs to completion</text>
        </g>

        <g id="node-ticks" data-step="ticks" tabindex="0" role="button" aria-pressed="false" aria-label="process.nextTick queue — Node, not libuv" data-detail="After each callback, in any phase, Node empties the whole nextTick queue first. It is not a libuv phase, so ticks that keep scheduling ticks can starve the loop.">
