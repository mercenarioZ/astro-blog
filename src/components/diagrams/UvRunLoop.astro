          </g>
          <text x="322.6" y="237" class="t-primary" font-size="10" font-weight="600" text-anchor="middle">uv__loop_alive()</text>
          <text x="322.6" y="251.6" class="t-muted" font-size="8" text-anchor="middle">any work left?</text>
          <text x="322.6" y="264.4" class="t-backend" font-size="8" text-anchor="middle">while condition</text>
        </g>

        <g id="node-pending" data-step="pending" tabindex="0" role="button" aria-pressed="false" aria-label="1 · Pending callbacks — uv__run_pending()" data-detail="I/O callbacks that were deferred to the next pass. After the poll it runs again, at most eight rounds, so callbacks that queue more callbacks cannot starve timers.">
