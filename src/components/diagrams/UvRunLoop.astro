        <path data-edge-from="poll" data-edge-to="check" d="M 656.6 154 L 656.6 326" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="pending" data-edge-to="idle" d="M 392.6 120 L 424.6 120" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="timers" data-edge-to="gate" d="M 322.6 326 L 322.6 274" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="loop" data-edge-to="glue" d="M 752 78 L 836 78" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="glue" data-edge-to="loop" d="M 836 100 L 752 100" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="glue" data-edge-to="v8" d="M 908 112 L 908 148" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="v8" data-edge-to="js" d="M 908 198 L 908 234" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
        <path data-edge-from="js" data-edge-to="ticks" d="M 908 284 L 908 320" class="a-default" stroke-width="1.4" marker-end="url(#uv-loop-arrowhead)" />
