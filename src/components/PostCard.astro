---
import {
  getPostDate,
  getPostTags,
  type PostModule,
} from "../lib/posts";

interface Props {
  post: PostModule;
  index?: number;
}

const { post, index = 1 } = Astro.props as Props;
const tags = getPostTags(post);
---

<a href={post.url} class="post-row">
  <span class="post-row__number" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </span>

  <span class="post-row__body">
    <span class="post-row__meta">
      <time>{getPostDate(post)}</time>
      <span aria-hidden="true">/</span>
      <span>{tags.join(", ")}</span>
    </span>
    <span class="post-row__title">{post.frontmatter.title}</span>
    <span class="post-row__description">
      {post.frontmatter.description}
    </span>
  </span>

  <span class="post-row__arrow" aria-hidden="true">↗</span>
</a>
