---
import "../../styles/blog-post.css";
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import MainHead from "./MainHead.astro";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  content: {
    title: string;
    description: string;
    createdAt?: string;
    updatedAt?: string;
    heroImage?: string;
    tags?: string[];
  };
}

const {
  content: { title, description, heroImage, createdAt },
} = Astro.props;

const formattedDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};
---

<MainHead
  title={title}
  image={heroImage}
/>

<Body>
  <Header />

  <main class="pt-[50px]">
    <Content className="markdown-body pt-4">
      <div class="post-enter post-enter-hero mb-6 flex justify-center">
        {
          heroImage && (
            <div class="w-full max-w-[960px]">
              <img
                src={heroImage}
                alt={title}
                class="mx-auto block h-auto max-h-[70vh] w-auto max-w-full object-contain mb-0 border-0 rounded-none shadow-none"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
      </div>

      <div class="post-enter post-enter-meta">
        {createdAt && <p class="post-date"><i>{formattedDate(createdAt)}</i></p>}
      </div>

      <div class="post-enter post-enter-title mb-4 flex flex-col items-center">
        <h1 class="font-bold text-3xl mb-4">{title}</h1>
        <div class="opacity-75">{description}</div>
      </div>

      <!-- <hr class="my-4 border-top border-zinc-600" /> -->
      <div class="post-enter post-enter-content pt-4">
        <slot />
      </div>
    </Content>
  </main>
  <Footer />
</Body>
