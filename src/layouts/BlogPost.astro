---
import "../../styles/blog-post.css";
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";
import { getPostImage } from "../lib/images";
import MainLayout from "./MainLayout.astro";

export interface Props {
  content: {
    title: string;
    description: string;
    createdAt?: string;
    updatedAt?: string;
    heroImage?: string;
    tags?: string[];
  };
}

const {
  content: { title, description, heroImage, createdAt },
} = Astro.props;
const resolvedHeroImage = heroImage ? getPostImage(heroImage) : undefined;

const formattedDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};
---

<MainLayout
  title={title}
  description={description}
  image={resolvedHeroImage}
  type="article"
>
  <Header />

  <main class="pt-[50px]">
    <Content className="markdown-body pt-4">
      <div class="post-enter post-enter-hero mb-6 flex justify-center">
        {
          resolvedHeroImage && (
            <div class="w-full max-w-[960px]">
              {typeof resolvedHeroImage === "string" ? (
                <img
                  src={resolvedHeroImage}
                  alt={title}
                  width="1200"
                  height="742"
                  class="mx-auto block h-auto max-h-[70vh] w-auto max-w-full object-contain mb-0 border-0 rounded-none shadow-none"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <Image
                  src={resolvedHeroImage}
                  alt={title}
                  width={960}
                  class="mx-auto block h-auto max-h-[70vh] w-auto max-w-full object-contain mb-0 border-0 rounded-none shadow-none"
                  loading="eager"
                  decoding="async"
                />
              )}
            </div>
          )
        }
      </div>

      <div class="post-enter post-enter-meta">
        {createdAt && <p class="post-date"><i>{formattedDate(createdAt)}</i></p>}
      </div>

      <div class="post-enter post-enter-title mb-4 flex flex-col items-center">
        <h1 class="font-bold text-3xl mb-4">{title}</h1>
        <div class="opacity-75">{description}</div>
      </div>

      <!-- <hr class="my-4 border-top border-zinc-600" /> -->
      <div class="post-enter post-enter-content pt-4">
        <slot />
      </div>
    </Content>
  </main>
  <Footer />
</MainLayout>
