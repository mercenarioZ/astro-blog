---
import Header from "../components/Header.astro";
import Body from "../components/Body.astro";
import MainHead from "./MainHead.astro";
import Content from "../components/Content.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  content: {
    title: string;
    description: string;
    createdAt?: string;
    updatedAt?: string;
    heroImage?: string;
    tags?: string[];
  };
}

const {
  content: { title, description, heroImage, createdAt },
} = Astro.props;

const formattedDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};
---

<MainHead
  title={title}
  image={heroImage}
/>

<Body>
  <Header />

  <style is:global>
    @reference "../../styles/global.css";

    main article.markdown-body {
      ul {
        @apply list-disc list-inside pl-4 mb-4;
      }

      h1,
      h2,
      h3,
      h4,
      h5 {
        @apply font-bold;
      }

      h1 {
        @apply text-4xl mb-2;
      }

      h2 {
        @apply mt-10 mb-4 text-3xl;
      }

      h3 {
        @apply mt-8 mb-3 text-2xl;
      }

      h4 {
        @apply text-xl;
      }

      img {
        @apply rounded-lg shadow-xl border border-slate-300 dark:border-zinc-700 mb-4;
      }

      p {
        @apply mb-4;
      }

      :not(pre) > code {
        @apply rounded bg-slate-200 px-1.5 py-0.5 text-sm text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100;
      }

      pre {
        @apply mb-6 overflow-x-auto rounded-lg border border-slate-300 bg-zinc-950 p-4 text-sm text-zinc-100 shadow-xl dark:border-zinc-700;
      }

      pre code {
        @apply bg-transparent p-0 text-inherit;
      }

      table {
        @apply mb-6 w-full border-collapse overflow-hidden rounded-lg border border-slate-300 text-left text-sm shadow-lg dark:border-zinc-700;
      }

      thead {
        @apply bg-slate-200 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100;
      }

      th,
      td {
        @apply border-b border-slate-300 px-4 py-3 align-top dark:border-zinc-700;
      }

      th {
        @apply font-bold;
      }

      tbody tr:last-child td {
        @apply border-b-0;
      }

      tbody tr {
        @apply bg-white/45 dark:bg-zinc-900/45;
      }

      tbody tr:nth-child(even) {
        @apply bg-slate-100/70 dark:bg-zinc-800/35;
      }

      td:first-child {
        @apply w-32 whitespace-nowrap font-medium;
      }

      a {
        @apply text-orange-500 hover:text-orange-300 transition underline underline-offset-2 decoration-orange-400;
      }
    }
  </style>

  <main class="pt-[50px]">
    <Content className="markdown-body pt-4">
      <div class="post-enter post-enter-hero mb-6 flex justify-center">
        {
          heroImage && (
            <div class="w-full max-w-[720px] h-auto rounded-xl border border-slate-400 dark:border-zinc-700 shadow-xl bg-slate-100 dark:bg-zinc-800/60 overflow-hidden">
              <img
                src={heroImage}
                alt={title}
                class="block w-full h-full object-cover mb-0 border-0 shadow-none"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }
      </div>

      <div class="post-enter post-enter-meta opacity-75">
        {createdAt && <p>{formattedDate(createdAt)}</p>}
      </div>

      <div class="post-enter post-enter-title mb-4 flex flex-col items-center">
        <h1 class="font-bold text-3xl mb-4">{title}</h1>
        <div class="opacity-75">{description}</div>
      </div>

      <!-- <hr class="my-4 border-top border-zinc-600" /> -->
      <div class="post-enter post-enter-content indent-4 pt-4 ">
        <slot />
      </div>
    </Content>
  </main>
  <Footer />
</Body>

<style>
  .post-enter {
    animation: post-enter 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: opacity, transform, filter;
  }

  .post-enter-hero {
    animation-delay: 40ms;
  }

  .post-enter-meta {
    animation-delay: 180ms;
  }

  .post-enter-title {
    animation-delay: 260ms;
  }

  .post-enter-content {
    animation-delay: 380ms;
  }

  .post-enter-hero img {
    animation: post-image-settle 1100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: center;
  }

  @keyframes post-enter {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      filter: blur(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes post-image-settle {
    from {
      transform: scale(1.045);
    }

    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-enter,
    .post-enter-hero img {
      animation: none;
      filter: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
