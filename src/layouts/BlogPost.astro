---
import "../../styles/blog-post.css";
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getPostImage } from "../lib/images";
import MainLayout from "./MainLayout.astro";

export interface Props {
  content: {
    title: string;
    description: string;
    createdAt?: string;
    updatedAt?: string;
    heroImage?: string;
    tags?: string[];
    tag?: string[];
  };
}

const { content } = Astro.props;
const { title, description, heroImage, createdAt, updatedAt } = content;
const tags = content.tags ?? content.tag ?? [];
const resolvedHeroImage = heroImage ? getPostImage(heroImage) : undefined;

const formattedDate = (dateStr: string) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(new Date(dateStr));

// YAML parses bare dates into Date objects, so normalise to YYYY-MM-DD.
const isoDate = (dateStr: string) =>
  new Date(dateStr).toISOString().slice(0, 10);
---

<MainLayout
  title={title}
  description={description}
  image={resolvedHeroImage}
  type="article"
>
  <Header />

  <main class="post">
    <article class="markdown-body">
      <header class="post-header">
        <div class="post-header__meta">
          {createdAt && <time datetime={isoDate(createdAt)}>{formattedDate(createdAt)}</time>}
          {updatedAt && <time datetime={isoDate(updatedAt)}>Updated {formattedDate(updatedAt)}</time>}
          {tags.length > 0 && <span>{tags.join(" · ")}</span>}
        </div>

        <h1>{title}</h1>
        <p class="post-header__description">{description}</p>
      </header>

      {
        resolvedHeroImage && (
          <figure class="post-hero">
            {typeof resolvedHeroImage === "string" ? (
              <img
                src={resolvedHeroImage}
                alt={title}
                width="1200"
                height="742"
                loading="eager"
                decoding="async"
              />
            ) : (
              <Image
                src={resolvedHeroImage}
                alt={title}
                width={960}
                loading="eager"
                decoding="async"
              />
            )}
          </figure>
        )
      }

      <div class="post-content">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
</MainLayout>
